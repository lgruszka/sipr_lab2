<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sipr_lab2</name>
  <version>0.0.0</version>
  <description>SiPR – ćwiczenie 2 – sterowanie robotem o napędzie różnicowym</description>
  <maintainer email="maciej.przybylski@mchtr.pw.edu.pl">Maciej Przybylski</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Biblioteki używane w kodzie węzła sipr_lab2_node -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>angles</depend>

  <!-- Programy uruchamiane przez pliki launch -->
  <exec_depend>mvsim</exec_depend>
  <exec_depend>odom_to_tf_ros2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
